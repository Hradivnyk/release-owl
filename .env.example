# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info          # debug | info | warn | error
# NODE_ENV also controls log format: development → pretty print, production → JSON

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=release_owl_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/release_owl_db

# GitHub API
# Optional. Without a token the API rate limit is 60 req/h per IP.
# Required for private repositories or higher rate limits (5000 req/h).
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Message broker (RabbitMQ)
# The app publishes email.requested events; the notification service consumes them
# and replies with email.sent / email.failed (Saga pattern).
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Credentials used by the rabbitmq container (docker-compose)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
# Port the notification service exposes its health endpoint on.
HEALTH_PORT=3002

# Notification service database (separate PostgreSQL instance)
NOTIFICATION_POSTGRES_USER=postgres
NOTIFICATION_POSTGRES_PASSWORD=postgres
NOTIFICATION_POSTGRES_DB=notification_db

# SMTP (email transport) — used by the notification service
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_password
# Address that appears in the "From" field of sent emails
SMTP_FROM=noreply@example.com
# Retry policy for SMTP delivery inside the notification service
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_MS=500

# Application
# Base URL used to build confirmation and unsubscribe links in emails
# (consumed by the notification service)
BASE_URL=http://localhost:3000
# Allowed CORS origin. Use '*' to allow all origins (not recommended in production)
ALLOWED_ORIGIN=http://localhost:3000

# Scanner
# Cron schedule for checking new GitHub releases (default: every hour)
# Uses standard cron syntax: minute hour day month weekday
SCANNER_CRON_SCHEDULE=0 * * * *

# API Key Authentication
# Secret token clients must send in the X-API-Key header.
# Leave empty to disable authentication (not recommended in production).
# Generate with: openssl rand -hex 32
API_KEY=

# Caddy reverse proxy (used in production profile only)
# Set to your actual domain, e.g. api.example.com
DOMAIN=localhost

# Kibana basic auth (used in production profile only)
# Username for accessing kibana.<DOMAIN>
KIBANA_USER=admin
# Bcrypt-hashed password. Generate with: caddy hash-password --plaintext yourpassword
KIBANA_HASHED_PASSWORD=

# Kibana encryption keys (must be at least 32 characters each)
# Generate with: openssl rand -hex 16
KIBANA_ENCRYPTEDSAVEDOBJECTS_KEY=
KIBANA_SECURITY_KEY=
KIBANA_REPORTING_KEY=

# Grafana (used in production profile only)
# Admin credentials for Grafana UI
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Bcrypt-hashed password for Caddy basic auth. Generate with: caddy hash-password --plaintext yourpassword
GRAFANA_HASHED_PASSWORD=
