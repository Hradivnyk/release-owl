services:
  app:
    ports:
      - '3000:3000'

  # Publish the notification transports so ghz (gRPC) and autocannon (REST)
  # can hit them from the host. Not published in production.
  notification:
    ports:
      - '50051:50051'
      - '4000:4000'

  db:
    ports:
      - '5432:5432'

  kibana:
    ports:
      - '127.0.0.1:5601:5601'

  prometheus:
    ports:
      - '127.0.0.1:9090:9090'

  grafana:
    ports:
      - '127.0.0.1:3001:3000'