{
  "name": "release-owl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@release-owl/contracts": "*",
    "@release-owl/platform": "*",
    "@release-owl/proto": "*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "js-yaml": "^4.1.1",
    "knex": "^3.2.9",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build:packages": "tsc -p packages/contracts/tsconfig.json && tsc -p packages/platform/tsconfig.json && tsc -p packages/proto/tsconfig.json",
    "generate": "buf generate",
    "build": "npm run build:packages && tsc",
    "build:services": "npm run build:packages && tsc -p services/notification/tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "migrate:rollback": "node --import tsx/esm node_modules/.bin/knex --knexfile knexfile.ts migrate:rollback",
    "migrate:make": "node --import tsx/esm node_modules/.bin/knex --knexfile knexfile.ts migrate:make",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm run build",
    "ci": "npm run quality && npm run test",
    "test": "npm run test:unit && npm run test:integration:ci && npm run test:e2e:ci",
    "test:unit": "jest --selectProjects unit notification platform",
    "test:unit:coverage": "npm run test:unit -- --coverage",
    "test:integration:ci": "node scripts/run-with-compose.cjs -f docker-compose.test.yml -- jest --selectProjects integration --runInBand",
    "test:integration:coverage": "npm run test:integration:ci -- --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ci": "node scripts/run-with-compose.cjs -p software-engineering-school-6-0-hradivnyk-e2e -f docker-compose.e2e.yml --env PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 --env PLAYWRIGHT_SKIP_WEBSERVER=1 -- playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "node .husky/install.mjs"
  },
  "lint-staged": {
    "**/*.{ts,js,cjs,mjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pino-http": "^5.8.4",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-security": "^4.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-proto": "^2.11.8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.1"
  }
}
